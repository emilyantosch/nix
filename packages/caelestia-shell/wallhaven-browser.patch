diff --git a/modules/bar/components/WallhavenButton.qml b/modules/bar/components/WallhavenButton.qml
new file mode 100644
index 0000000..14fecd8
--- /dev/null
+++ b/modules/bar/components/WallhavenButton.qml
@@ -0,0 +1,32 @@
+import QtQuick
+import Caelestia.Config
+import qs.components
+import qs.services
+
+// Bar entry "wallhaven": hover opens the wallhaven browser popout. Spins while
+// a picked wallpaper downloads.
+Item {
+    id: root
+
+    implicitWidth: icon.implicitHeight + Tokens.padding.small
+    implicitHeight: icon.implicitHeight
+
+    MaterialIcon {
+        id: icon
+
+        anchors.centerIn: parent
+
+        text: Wallhaven.downloading ? "progress_activity" : "wallpaper"
+        color: Colours.palette.m3secondary
+        fontStyle: Tokens.font.icon.builders.small.weight(Font.Bold).build()
+
+        RotationAnimation on rotation {
+            running: Wallhaven.downloading !== ""
+            loops: Animation.Infinite
+            from: 0
+            to: 360
+            duration: 1000
+            onRunningChanged: if (!running) icon.rotation = 0
+        }
+    }
+}
