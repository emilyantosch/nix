diff --git a/services/AudioRecorder.qml b/services/AudioRecorder.qml
new file mode 100644
index 0000000..f1a40ab
--- /dev/null
+++ b/services/AudioRecorder.qml
@@ -0,0 +1,113 @@
+pragma Singleton
+
+import QtQuick
+import Quickshell
+import Quickshell.Io
+
+// Audio recording state from the `voice-record` script (modules/home-manager/
+// voice-record.nix), which runs pw-record as the transient voice-recording user
+// unit. The script pings `ipc call audiorecorder refresh` on every start and stop,
+// so nothing here polls.
+Singleton {
+    id: root
+
+    property bool recording
+    // Epoch ms the recording started, so a restarted shell shows the right time
+    property real startedAt
+    property int elapsed // seconds
+
+    // Cycled while recording; each recording starts on the next one
+    readonly property list<string> gifs: ["rec-puppy-girl", "rec-ahri", "rec-puppy-dancing", "rec-winnie"].map(g => gifPath(g))
+    property int gifIndex
+    readonly property string gif: gifs[gifIndex % gifs.length]
+
+    function gifPath(name: string): string {
+        return Qt.resolvedUrl(`${Quickshell.shellDir}/assets/gifs/${name}.gif`);
+    }
+
+    function formatElapsed(secs: int): string {
+        const h = Math.floor(secs / 3600);
+        const m = Math.floor(secs / 60) % 60;
+        const s = String(secs % 60).padStart(2, "0");
+        return h > 0 ? `${h}:${String(m).padStart(2, "0")}:${s}` : `${m}:${s}`;
+    }
+
+    // A ping that lands mid-query reruns it, so the last state always wins
+    property bool refreshPending
+
+    function refresh(): void {
+        if (query.running)
+            refreshPending = true;
+        else
+            query.running = true;
+    }
+
+    function stop(): void {
+        Quickshell.execDetached(["voice-record", "stop"]);
+    }
+
+    function cancel(): void {
+        Quickshell.execDetached(["voice-record", "cancel"]);
+    }
+
+    onRecordingChanged: {
+        if (recording)
+            gifIndex = (gifIndex + 1) % gifs.length;
+        updateElapsed();
+    }
+
+    function updateElapsed(): void {
+        elapsed = recording && startedAt > 0 ? Math.max(0, Math.floor((Date.now() - startedAt) / 1000)) : 0;
+    }
+
+    Component.onCompleted: refresh()
+
+    IpcHandler {
+        function refresh(): void {
+            root.refresh();
+        }
+
+        target: "audiorecorder"
+    }
+
+    Process {
+        id: query
+
+        command: ["systemctl", "--user", "show", "voice-recording", "--timestamp=unix", "--property=ActiveState,ActiveEnterTimestamp"]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                const props = {};
+                for (const line of text.split("\n")) {
+                    const eq = line.indexOf("=");
+                    if (eq > 0)
+                        props[line.slice(0, eq)] = line.slice(eq + 1);
+                }
+                const active = props.ActiveState === "active" || props.ActiveState === "activating";
+                const since = parseInt((props.ActiveEnterTimestamp ?? "").replace("@", ""), 10);
+                root.startedAt = active ? (since > 0 ? since * 1000 : Date.now()) : 0;
+                root.recording = active;
+                root.updateElapsed();
+            }
+        }
+        onExited: { // qmllint disable signal-handler-parameters
+            if (root.refreshPending) {
+                root.refreshPending = false;
+                query.running = true;
+            }
+        }
+    }
+
+    Timer {
+        interval: 1000
+        repeat: true
+        running: root.recording
+        onTriggered: root.updateElapsed()
+    }
+
+    Timer {
+        interval: 6000
+        repeat: true
+        running: root.recording
+        onTriggered: root.gifIndex = (root.gifIndex + 1) % root.gifs.length
+    }
+}
