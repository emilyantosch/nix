diff --git a/modules/bar/components/status/AudioRecorderStatus.qml b/modules/bar/components/status/AudioRecorderStatus.qml
new file mode 100644
index 0000000..c95d081
--- /dev/null
+++ b/modules/bar/components/status/AudioRecorderStatus.qml
@@ -0,0 +1,59 @@
+import QtQuick
+import Caelestia.Config
+import qs.components
+import qs.services
+
+// Audio recording indicator: grows in while `voice-record` records, cycling
+// through the recording GIFs, and collapses to nothing otherwise.
+// Left click saves, right click discards.
+Item {
+    id: root
+
+    // Read by the bar to pick the hover popout
+    readonly property string name: "audiorecorder"
+    readonly property int gifSize: Math.round(Tokens.sizes.bar.innerWidth * 0.8)
+
+    property real shownHeight: AudioRecorder.recording ? gifSize : 0
+
+    implicitWidth: gifSize
+    implicitHeight: Math.round(shownHeight)
+
+    Behavior on shownHeight {
+        Anim {
+            type: Anim.SlowEffects
+        }
+    }
+
+    AnimatedImage {
+        anchors.centerIn: parent
+        width: root.gifSize
+        height: root.gifSize
+
+        source: AudioRecorder.gif
+        fillMode: AnimatedImage.PreserveAspectFit
+        smooth: true
+        mipmap: true
+        playing: AudioRecorder.recording
+        visible: opacity > 0
+        opacity: AudioRecorder.recording ? 1 : 0
+        scale: AudioRecorder.recording ? 1 : 0.5
+
+        Behavior on opacity {
+            Anim {
+                type: Anim.DefaultEffects
+            }
+        }
+
+        Behavior on scale {
+            Anim {}
+        }
+    }
+
+    MouseArea {
+        anchors.fill: parent
+        enabled: AudioRecorder.recording
+        acceptedButtons: Qt.LeftButton | Qt.RightButton
+        cursorShape: Qt.PointingHandCursor
+        onClicked: event => event.button === Qt.RightButton ? AudioRecorder.cancel() : AudioRecorder.stop()
+    }
+}
