diff --git a/services/Voxtype.qml b/services/Voxtype.qml
new file mode 100644
index 0000000..cb32861
--- /dev/null
+++ b/services/Voxtype.qml
@@ -0,0 +1,100 @@
+pragma Singleton
+
+import QtQuick
+import Quickshell
+import Quickshell.Io
+
+// Dictation state from the voxtype daemon. `status --follow` watches its state
+// file with inotify and prints one JSON line per change (and "stopped" when the
+// daemon goes away), so nothing here polls.
+Singleton {
+    id: root
+
+    // "idle", "recording", "transcribing" or "stopped"
+    property string state: "stopped"
+
+    readonly property bool recording: state === "recording"
+    readonly property bool transcribing: state === "transcribing"
+    readonly property bool active: recording || transcribing
+
+    // Recent mic levels while recording, 0..1 on a dB scale, oldest first
+    readonly property int levelCount: 32
+    property var levels: new Array(levelCount).fill(0)
+    property real peakAcc: 0
+
+    onRecordingChanged: {
+        peakAcc = 0;
+        levels = new Array(levelCount).fill(0);
+    }
+
+    function toggle(): void {
+        Quickshell.execDetached(["voxtype", "record", "toggle"]);
+    }
+
+    function stop(): void {
+        Quickshell.execDetached(["voxtype", "record", "stop"]);
+    }
+
+    function cancel(): void {
+        Quickshell.execDetached(["voxtype", "record", "cancel"]);
+    }
+
+    Process {
+        id: follow
+
+        running: true
+        command: ["voxtype", "status", "--follow", "--format", "json"]
+        stdout: SplitParser {
+            onRead: data => {
+                try {
+                    const status = JSON.parse(data);
+                    root.state = status.class || status.alt || "stopped";
+                } catch (e) {
+                    // Ignore partial or non-JSON lines
+                }
+            }
+        }
+        // voxtype missing or the follower died: show nothing and retry later
+        onExited: { // qmllint disable signal-handler-parameters
+            root.state = "stopped";
+            restart.start();
+        }
+    }
+
+    // The daemon streams 100 Hz binary level frames over a socket while recording;
+    // the bridge re-emits them as NDJSON ({"peak":…,"rms":…,"vad":…}).
+    Process {
+        running: root.recording
+        command: ["voxtype-audio-bridge"]
+        stdout: SplitParser {
+            onRead: data => {
+                try {
+                    const frame = JSON.parse(data);
+                    if (frame.peak !== undefined)
+                        root.peakAcc = Math.max(root.peakAcc, frame.peak);
+                } catch (e) {}
+            }
+        }
+    }
+
+    // Fold the frames into one bar per 40 ms
+    Timer {
+        interval: 40
+        repeat: true
+        running: root.recording
+        onTriggered: {
+            // Room tone sits near -60 dBFS, loud speech around -10
+            const db = 20 * Math.log10(Math.max(root.peakAcc, 1e-6));
+            const value = Math.max(0, Math.min(1, (db + 60) / 50));
+            root.levels = [...root.levels.slice(1), value];
+            root.peakAcc = 0;
+        }
+    }
+
+    Timer {
+        id: restart
+
+        interval: 5000
+        onTriggered: follow.running = true
+    }
+}
