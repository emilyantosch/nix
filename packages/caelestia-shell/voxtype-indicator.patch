diff --git a/modules/dictation/Content.qml b/modules/dictation/Content.qml
new file mode 100644
index 0000000..df6c240
--- /dev/null
+++ b/modules/dictation/Content.qml
@@ -0,0 +1,81 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import Caelestia.Config
+import qs.components
+import qs.services
+
+// Mic + scrolling level bars while recording; a slow wave and a spinner while
+// transcribing.
+Item {
+    id: root
+
+    readonly property int barWidth: 4
+    readonly property int barGap: 3
+    readonly property int barsHeight: 28
+    property real phase
+
+    implicitWidth: row.implicitWidth + Tokens.padding.extraLarge * 2
+    implicitHeight: row.implicitHeight + Tokens.padding.large * 2
+
+    FrameAnimation {
+        running: Voxtype.transcribing
+        onTriggered: root.phase += frameTime * 5
+    }
+
+    Row {
+        id: row
+
+        anchors.centerIn: parent
+        spacing: Tokens.spacing.medium
+
+        MaterialIcon {
+            id: icon
+
+            anchors.verticalCenter: parent.verticalCenter
+
+            text: Voxtype.transcribing ? "progress_activity" : "mic"
+            color: Voxtype.transcribing ? Colours.palette.m3secondary : Colours.palette.m3error
+            fill: 1
+            fontStyle: Tokens.font.icon.medium
+
+            RotationAnimation on rotation {
+                running: Voxtype.transcribing
+                loops: Animation.Infinite
+                from: 0
+                to: 360
+                duration: 1000
+                onRunningChanged: if (!running) icon.rotation = 0
+            }
+        }
+
+        Row {
+            anchors.verticalCenter: parent.verticalCenter
+            height: root.barsHeight
+            spacing: root.barGap
+
+            Repeater {
+                model: Voxtype.levelCount
+
+                StyledRect {
+                    required property int index
+
+                    readonly property real value: Voxtype.transcribing ? 0.2 + 0.25 * (0.5 + 0.5 * Math.sin(root.phase - index * 0.45)) : (Voxtype.levels[index] ?? 0)
+
+                    anchors.verticalCenter: parent.verticalCenter
+                    implicitWidth: root.barWidth
+                    implicitHeight: Math.max(root.barWidth, root.barsHeight * value)
+                    radius: root.barWidth / 2
+                    color: Voxtype.transcribing ? Colours.palette.m3secondary : Colours.palette.m3primary
+
+                    Behavior on implicitHeight {
+                        NumberAnimation {
+                            duration: 90
+                            easing.type: Easing.OutQuad
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
diff --git a/modules/dictation/Wrapper.qml b/modules/dictation/Wrapper.qml
new file mode 100644
index 0000000..55d4c8b
--- /dev/null
+++ b/modules/dictation/Wrapper.qml
@@ -0,0 +1,41 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import Quickshell
+import Caelestia.Config
+import qs.components
+import qs.services
+
+// Bottom-centre pill while voxtype dictates, where the launcher opens, so it's
+// in view while looking at the text you're dictating into. Only on the focused
+// screen, and it makes way for the launcher.
+Item {
+    id: root
+
+    required property ShellScreen screen
+    required property ScreenState screenState
+
+    readonly property bool shouldBeActive: Voxtype.active && !screenState.launcher && ShellState.isActiveScreen(screen)
+    property real offsetScale: shouldBeActive ? 0 : 1
+
+    visible: offsetScale < 1
+    anchors.bottomMargin: (-implicitHeight - 5) * offsetScale
+    implicitWidth: content.implicitWidth
+    implicitHeight: content.implicitHeight
+    opacity: 1 - offsetScale
+
+    Behavior on offsetScale {
+        Anim {}
+    }
+
+    Loader {
+        id: content
+
+        anchors.top: parent.top
+        anchors.horizontalCenter: parent.horizontalCenter
+
+        active: root.shouldBeActive || root.visible
+
+        sourceComponent: Content {}
+    }
+}
